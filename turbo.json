{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bin/**", "src-tauri/target/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "format": {
      "cache": false
    },
    "format:check": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "@agentpay/api#build": {
      "dependsOn": [],
      "outputs": ["bin/**"],
      "cache": true
    },
    "@agentpay/api#dev": {
      "cache": false,
      "persistent": true
    },
    "@agentpay/api#lint": {
      "cache": true
    }
  }
}
