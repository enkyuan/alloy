{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bin/**", "src-tauri/target/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "format": {
      "cache": false
    },
    "format:check": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "@ryo/api#build": {
      "dependsOn": [],
      "outputs": ["bin/**"],
      "cache": true
    },
    "@ryo/api#dev": {
      "cache": false,
      "persistent": false
    },
    "@ryo/api#lint": {
      "cache": true
    },
    "@ryo/auth#build": {
      "dependsOn": [],
      "outputs": ["dist/**"],
      "cache": true
    },
    "@ryo/auth#dev": {
      "cache": false,
      "persistent": true
    },
    "@ryo/auth#lint": {
      "cache": true
    },
    "@kaji/docs#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "cache": true
    },
    "@kaji/docs#dev": {
      "cache": false,
      "persistent": true
    },
    "@kaji/cli#build": {
      "dependsOn": [],
      "outputs": ["dist/**"],
      "cache": true
    },
    "kaji-sdk#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "@kaji/cli#dev": {
      "cache": false,
      "persistent": false
    }
  }
}
