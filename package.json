{
  "name": "kaji",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "ryo/*",
    "kaji/*",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "audit:ast-grep": "bunx -p @ast-grep/cli sg scan --config sgconfig.yml kaji",
    "prepare": "husky",
    "docker:up": "docker compose -f docker/ryo/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/ryo/docker-compose.yml down",
    "docker:destroy": "docker compose -f docker/ryo/docker-compose.yml down -v --remove-orphans",
    "docker:logs": "docker compose -f docker/ryo/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "husky": "^9.1.0",
    "oxlint": "^1.1.0",
    "oxfmt": "^0.41.0"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22.0.0"
  }
}
