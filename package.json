{
  "name": "alloy",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "ryo/*",
    "kaji/*",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "ast-grep:test": "sg test -t tools/ast-grep/rule-tests --skip-snapshot-tests",
    "ast-grep:scan": "sg scan --config sgconfig.yml kaji",
    "audit:ast-grep": "bun run ast-grep:test && bun run ast-grep:scan",
    "audit:kaji-beta": "uv run --project kaji python kaji/scripts/beta_release_check.py",
    "audit:kaji-beta:release": "uv run --project kaji python kaji/scripts/beta_release_check.py --release",
    "verify:kaji-package-metadata": "uv run --project kaji python kaji/scripts/verify_package_metadata.py",
    "benchmark:kaji-beta": "uv run --project kaji python kaji/scripts/run_beta_benchmarks.py --quick",
    "benchmark:kaji-beta:full": "uv run --project kaji python kaji/scripts/run_beta_benchmarks.py --full",
    "soak:kaji-beta": "uv run --project kaji python kaji/scripts/run_beta_soak.py --minutes 30",
    "parity": "uv run --project kaji python kaji/scripts/check_sdk_parity.py",
    "prepare": "husky",
    "docker:up": "docker compose -f docker/ryo/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/ryo/docker-compose.yml down",
    "docker:destroy": "docker compose -f docker/ryo/docker-compose.yml down -v --remove-orphans",
    "docker:logs": "docker compose -f docker/ryo/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.44.1",
    "turbo": "^2.5.0",
    "husky": "^9.1.0",
    "oxlint": "^1.1.0",
    "oxfmt": "^0.41.0"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22.0.0"
  }
}
