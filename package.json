{
  "name": "alloy",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "ryo/*",
    "kaji/packages/*",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:kaji-serve": "dotenvx run --ignore=MISSING_ENV_FILE -- uv run --project kaji/packages/serve uvicorn kaji_serve.server.app:app --reload --host 0.0.0.0 --port 8080",
    "env:example": "dotenvx genexample",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "test:kaji-python": "uv run --package kaji pytest",
    "test:kaji-serve": "uv run --package kaji-serve pytest",
    "test:kaji-typescript": "bun --filter kaji test",
    "ast-grep:test": "sg test -t tools/ast-grep/rule-tests --skip-snapshot-tests",
    "ast-grep:scan": "sg scan --config sgconfig.yml kaji",
    "audit:ast-grep": "bun run ast-grep:test && bun run ast-grep:scan",
    "check:workflows": "uv run --project kaji/packages/py --no-sync python kaji/scripts/check_workflows.py",
    "ci:kaji": "uv run --project kaji/packages/py --no-sync python kaji/scripts/beta_release_check.py --gate",
    "ci:local": "uv run --project kaji/packages/py --no-sync python kaji/scripts/check_workflows.py --gate",
    "audit:kaji": "uv run --project kaji/packages/py python kaji/scripts/beta_release_check.py",
    "audit:kaji:release": "uv run --project kaji/packages/py python kaji/scripts/beta_release_check.py --release",
    "verify:kaji-package-metadata": "uv run --project kaji/packages/py python kaji/scripts/verify_package_metadata.py",
    "benchmark:kaji": "uv run --project kaji/packages/py python kaji/scripts/run_beta_benchmarks.py --quick",
    "benchmark:kaji:full": "uv run --project kaji/packages/py python kaji/scripts/run_beta_benchmarks.py --full",
    "soak:kaji": "uv run --project kaji/packages/py python kaji/scripts/run_beta_soak.py --minutes 30",
    "parity": "uv run --project kaji/packages/py python kaji/scripts/check_sdk_parity.py",
    "prepare": "husky",
    "docker:up": "docker compose -f docker/ryo/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/ryo/docker-compose.yml down",
    "docker:destroy": "docker compose -f docker/ryo/docker-compose.yml down -v --remove-orphans",
    "docker:logs": "docker compose -f docker/ryo/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.44.1",
    "@dotenvx/dotenvx": "2.9.0",
    "turbo": "^2.5.0",
    "husky": "^9.1.0",
    "oxlint": "^1.1.0",
    "oxfmt": "^0.41.0"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22.0.0"
  },
  "patchedDependencies": {
    "agentation@3.0.2": "patches/agentation@3.0.2.patch"
  }
}
