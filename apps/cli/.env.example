# Modal Scripts CLI Configuration

# Path to the scripts directory
# Default: ../../modal/scripts (relative to the cli directory)
MODAL_SCRIPTS_DIR=/path/to/modal/scripts

# Optional: Set to "true" to enable debug mode
DEBUG=false

# Optional: Custom color scheme (hex colors)
COLOR_PRIMARY=#6B9FFF
COLOR_SECONDARY=#888888
COLOR_SUCCESS=#00FF00
COLOR_ERROR=#FF0000
COLOR_WARNING=#FFFF00
