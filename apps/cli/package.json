{
  "name": "@modal/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A clean, minimalistic TUI for running modal scripts - inspired by Claude CLI",
  "main": "src/index.ts",
  "bin": {
    "modal-cli": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --minify",
    "typecheck": "bunx tsgo --noEmit",
    "setup": "bash setup.sh",
    "clean": "rm -rf dist node_modules",
    "lint": "bunx tsgo --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,md}'",
    "help": "echo '\nAvailable commands:\n  dev      - Run the CLI in development mode\n  start    - Run the CLI\n  build    - Build for production\n  setup    - Run initial setup\n  clean    - Remove build artifacts\n'"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@opentui/core": "^0.1.0",
    "@typescript/native-preview": "^7.0.0-dev.20260123.3",
    "chalk": "^5.6.2",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0",
    "prettier": "^3.0.0"
  },
  "keywords": [
    "tui",
    "cli",
    "terminal",
    "opentui",
    "scripts",
    "bun"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enkyuan/modal.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/enkyuan/modal/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
