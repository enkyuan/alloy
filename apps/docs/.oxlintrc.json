{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import"],
  "categories": {},
  "rules": {
    "max-lines": [
      "warn",
      {
        "max": 400,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["node_modules/", "dist/", ".astro/"]
}
