---
interface Props {
  current?: boolean;
}

const { current = false } = Astro.props;
---

{
  current ? (
    <span class="kaji-wordmark" aria-current="page">
      <span class="sr-only">Kaji documentation</span>
      <span class="wordmark-text" aria-hidden="true">
        <span class="wordmark-glyph">鍛</span>
        <span class="wordmark-glyph">冶</span>
      </span>
    </span>
  ) : (
    <a class="kaji-wordmark" href="/" aria-label="Kaji documentation">
      <span class="wordmark-text" aria-hidden="true">
        <span class="wordmark-glyph">鍛</span>
        <span class="wordmark-glyph">冶</span>
      </span>
    </a>
  )
}
