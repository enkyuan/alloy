# =============================================================================
# agentpay/api — environment variables
# =============================================================================
# Copy to .env and fill in real values before running:
#   cp .env.example .env
#
# Loaded at startup via github.com/joho/godotenv (development only).
# In production, inject these directly into the process environment.
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=8090

# Origin of the Studio web app — used for CORS allow-list.
STUDIO_ORIGIN=http://localhost:5173


# -----------------------------------------------------------------------------
# Database (Postgres via pgx)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentpay?sslmode=disable

# Goose migrations target the same DSN.
# `make migrate` runs: goose -dir ./internal/store/migrations postgres "$DATABASE_URL" up


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# Auth (golang-jwt/jwt)
# -----------------------------------------------------------------------------

# Secret used to sign + verify JWT access tokens. Min 32 chars in production.
JWT_SECRET=CHANGE_ME_at_least_32_characters_long

# Token lifetime in minutes.
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30


# -----------------------------------------------------------------------------
# Payment providers
# -----------------------------------------------------------------------------

# Stripe — connect your own account or enable Connect for merchants.
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# Natural (natural.co) — agentic payment rail (A2B / A2C transfers).
NATURAL_API_KEY=CHANGE_ME
NATURAL_WEBHOOK_SECRET=CHANGE_ME

# Square — optional, for POS / in-person flows.
SQUARE_ACCESS_TOKEN=CHANGE_ME
SQUARE_WEBHOOK_SIGNATURE_KEY=CHANGE_ME
SQUARE_ENVIRONMENT=sandbox   # sandbox | production


# -----------------------------------------------------------------------------
# Wallet / KYB provider
# -----------------------------------------------------------------------------

# Natural wallet creation + KYB portal URL (returned to the Studio wizard).
# Re-uses NATURAL_API_KEY above; no extra key needed unless you use a
# separate Natural environment for wallet operations.
NATURAL_KYB_ENVIRONMENT=sandbox   # sandbox | production


# -----------------------------------------------------------------------------
# Temporal (workflow orchestration)
# -----------------------------------------------------------------------------
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agentpay


# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

# Structured log level: debug | info | warn | error
LOG_LEVEL=info

# Optional: export traces to an OTLP-compatible backend (Grafana, Honeycomb…)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agentpay-api
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
