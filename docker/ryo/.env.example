# ryo local stack — copy to .env and fill in values
# cp apps/docker/.env.example apps/docker/.env

# Postgres
POSTGRES_PASSWORD=ryo_dev

# Garage object storage
# Generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=change_me_in_prod

# Go API (consumed by apps/api)
DATABASE_URL=postgres://ryo:ryo-dev@localhost:5433/ryo?sslmode=disable
REDIS_URL=redis://localhost:6380

# Temporal
TEMPORAL_ADDRESS=localhost:7233

# Garage S3 (set after first `garage layout apply`)
GARAGE_S3_ENDPOINT=http://localhost:3900
GARAGE_S3_REGION=garage
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=

# Mail (dev — Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@ryo.local
