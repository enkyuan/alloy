# =============================================================================
# Kaji Docker Compose environment
# =============================================================================
#
# Usage:
#   cd docker/kaji
#   cp .env.example .env
#   # Replace every CHANGE_ME value before non-local use.
#   docker compose up -d
#
# Hostnames such as db and kong are Compose service names and resolve only
# inside the kaji-network.
# =============================================================================

# Kaji Serve application
API_PORT=8080
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME-postgres-password@db:5432/postgres
DEBUG=false
API_V1_PREFIX=/api/v1
PROJECT_NAME=Kaji Serve
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Model and voice providers exposed by Kaji Serve
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
SONIOX_API_KEY=

# Supabase API gateway
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
SUPABASE_KONG_URL=http://kong:8000
SUPABASE_ANON_KEY=CHANGE_ME-anon-key
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME-service-role-key

# JWT shared by Kaji Serve and Supabase Auth
JWT_SECRET=CHANGE_ME-super-secret-jwt-token-with-at-least-32-characters
JWT_ISSUER=http://localhost:8000/auth/v1
JWT_AUDIENCE=authenticated
JWT_EXPIRY=3600

# Postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=CHANGE_ME-postgres-password

# Supabase Auth
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false

# Google OAuth for Supabase Auth
ENABLE_GOOGLE_OAUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/v1/callback
GOOGLE_SKIP_NONCE_CHECK=false

# SMTP for Supabase Auth transactional email
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=Kaji
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
