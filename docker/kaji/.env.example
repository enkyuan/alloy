# =============================================================================
# AgentKit Docker Compose environment
# =============================================================================
#
# This is the single env file loaded by docker/docker-compose.yml. It supplies
# variables for BOTH the AgentKit application services (api, worker, bus-worker)
# and the bundled Supabase stack.
#
# Usage:
#   cd docker
#   cp .env.example .env
#   # edit .env: set the CHANGE_ME secrets, then:
#   docker compose up -d
#
# Values shown here are safe local-development defaults. Every secret marked
# CHANGE_ME MUST be replaced before any non-local deployment.
#
# Hostnames (db, redis, kong, ...) are Docker Compose service names and only
# resolve inside the agentkit-network. Do not use localhost here.
# =============================================================================


# -----------------------------------------------------------------------------
# AgentKit application
# -----------------------------------------------------------------------------

# Host port the API is published on (container always listens on 8080).
API_PORT=8080

# Postgres connection used by the app/workers. Points at the bundled `db`
# service. Must stay in sync with POSTGRES_* below.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/postgres

# Redis connection (caching, sessions, streams, TaskIQ). Points at `redis`.
REDIS_URL=redis://redis:6379/0

# JWT signing secret shared by the app AND the Supabase stack (gotrue, rest,
# storage, realtime, db all read this same value). Use a long random string.
JWT_SECRET=CHANGE_ME-super-secret-jwt-token-with-at-least-32-characters

# Optional. Key used to encrypt stored tokens. Falls back to JWT_SECRET if blank.
TOKEN_ENCRYPTION_KEY=

# Application behavior.
DEBUG=false
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Agent pipeline tuning.
AGENT_HISTORY_LIMIT=200
AGENT_CACHE_TTL_SECONDS=300


# -----------------------------------------------------------------------------
# Model + voice providers
# -----------------------------------------------------------------------------

# Google Gemini (LLM and optional Gemini TTS).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Soniox (real-time speech-to-text).
SONIOX_API_KEY=


# -----------------------------------------------------------------------------
# Supabase: API gateway (Kong)
# -----------------------------------------------------------------------------

# Host ports Kong is published on.
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Internal URL the app uses to reach Kong inside the network.
SUPABASE_KONG_URL=http://kong:8000

# Public URL the browser/Studio uses to reach the API gateway.
SUPABASE_PUBLIC_URL=http://localhost:8000

# Supabase API keys (JWTs signed with JWT_SECRET). Regenerate these for any
# non-local use; the values below are the well-known Supabase demo keys.
SUPABASE_ANON_KEY=CHANGE_ME-anon-key
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME-service-role-key


# -----------------------------------------------------------------------------
# Supabase: Postgres database
# -----------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=CHANGE_ME-postgres-password


# -----------------------------------------------------------------------------
# Supabase: Studio dashboard
# -----------------------------------------------------------------------------
STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project

# Basic-auth credentials guarding the Studio dashboard via Kong.
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=CHANGE_ME-dashboard-password


# -----------------------------------------------------------------------------
# Supabase: Auth (GoTrue)
# -----------------------------------------------------------------------------

# External URL of the auth service and the site it redirects back to.
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

# JWT lifetime in seconds (1 hour).
JWT_EXPIRY=3600

# Signup toggles.
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false

# Google OAuth (only needed if ENABLE_GOOGLE_OAUTH=true).
ENABLE_GOOGLE_OAUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/v1/callback
GOOGLE_SKIP_NONCE_CHECK=false

# SMTP for transactional auth email.
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=AgentKit

# Paths appended to SITE_URL in auth emails.
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify


# -----------------------------------------------------------------------------
# Supabase: PostgREST
# -----------------------------------------------------------------------------
PGRST_DB_SCHEMAS=public,storage,graphql_public


# -----------------------------------------------------------------------------
# Supabase: Storage / imgproxy
# -----------------------------------------------------------------------------
IMGPROXY_ENABLE_WEBP_DETECTION=true


# -----------------------------------------------------------------------------
# Supabase: Analytics (Logflare) + Vector
# -----------------------------------------------------------------------------
LOGFLARE_PUBLIC_ACCESS_TOKEN=CHANGE_ME-logflare-public-token
LOGFLARE_PRIVATE_ACCESS_TOKEN=CHANGE_ME-logflare-private-token
LOGFLARE_API_KEY=CHANGE_ME-logflare-api-key


# -----------------------------------------------------------------------------
# Host
# -----------------------------------------------------------------------------

# Path to the host Docker socket, mounted by the vector log collector.
# Linux/macOS default below; on some setups use /var/run/docker.sock.
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
