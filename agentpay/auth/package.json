{
  "name": "@agentpay/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "lint": "echo 'auth lint runs in CI'",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "better-auth": "^1.6.13",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/bun": "^1.0.0",
    "@types/pg": "^8.11.14",
    "typescript": "~6.0.2"
  }
}
