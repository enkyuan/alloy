# Kaji local development
#
# Usage:
#   cp .env.example .env
#   bun run dev:kaji-serve
#
# Dotenvx loads this file for repository commands. Keep real credentials in
# .env; that file and .env.keys are ignored by Git.

# Kaji SDK runtime
KAJI_MODEL_PROVIDER=mock
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# OpenRouter-hosted Kimi
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=
KIMI_MODEL=moonshotai/kimi-k2.6

# Cloudflare-hosted Kimi
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_KIMI_MODEL=@cf/moonshotai/kimi-k2.6

# Text-to-speech. Leave voice/model blank to use the selected provider's defaults.
TTS_PROVIDER=none
TTS_VOICE=
TTS_MODEL=

# Experimental GitHub integration
GITHUB_TOKEN=

# Kaji Serve direct-host configuration
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME-postgres-password@localhost:5432/postgres
SUPABASE_KONG_URL=http://localhost:8000
SUPABASE_ANON_KEY=CHANGE_ME-anon-key
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME-service-role-key
JWT_SECRET=CHANGE_ME-super-secret-jwt-token-with-at-least-32-characters
JWT_ISSUER=http://localhost:8000/auth/v1
JWT_AUDIENCE=authenticated
SONIOX_API_KEY=
DEBUG=false
API_V1_PREFIX=/api/v1
PROJECT_NAME=Kaji Serve
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
