# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@supabase-db:5432/postgres

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Supabase Configuration
# Get these from your Supabase project settings (https://supabase.com/dashboard)
SUPABASE_URL=http://kong:8000
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Soniox Speech-to-Text Configuration
# Get your API key from https://console.soniox.com/
SONIOX_API_KEY=your-soniox-api-key

# Google Gemini AI Configuration
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Text-to-Speech Configuration
# TTS_PROVIDER: none (default) or gemini. Gemini reuses GEMINI_API_KEY above.
TTS_PROVIDER=none
TTS_VOICE=Kore
TTS_MODEL=gemini-2.5-flash-preview-tts

# Application Settings
DEBUG=False
API_V1_PREFIX=/api/v1
PROJECT_NAME=AgentKit SDK
