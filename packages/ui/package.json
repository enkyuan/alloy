{
  "name": "@agentkit/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./dev": {
      "types": "./src/dev.tsx",
      "default": "./src/dev.tsx"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write \"**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx}\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "agentation": "^3.0.2",
    "typescript": "^6.0.0"
  }
}
