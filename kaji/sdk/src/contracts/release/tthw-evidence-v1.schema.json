{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaji.dev/contracts/release/tthw-evidence-v1.schema.json",
  "title": "Kaji exact-commit five-user TTHW evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commit",
    "releaseManifestSha256",
    "artifacts",
    "automatedTimings",
    "humanRuns",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "releaseManifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "automatedTimings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "npm", "bun"],
      "properties": {
        "python": { "$ref": "#/$defs/automatedTiming" },
        "npm": { "$ref": "#/$defs/automatedTiming" },
        "bun": { "$ref": "#/$defs/automatedTiming" }
      }
    },
    "humanRuns": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/humanRun" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noKeyMedianMs",
        "noKeyMaxMs",
        "echoMedianMs",
        "echoMaxMs"
      ],
      "properties": {
        "noKeyMedianMs": { "$ref": "#/$defs/milliseconds" },
        "noKeyMaxMs": { "$ref": "#/$defs/milliseconds" },
        "echoMedianMs": { "$ref": "#/$defs/milliseconds" },
        "echoMaxMs": { "$ref": "#/$defs/milliseconds" }
      }
    }
  },
  "$defs": {
    "milliseconds": { "type": "integer", "minimum": 0 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "package", "version", "size", "sha256"],
      "properties": {
        "name": {
          "enum": [
            "kaji-0.2.0b1-py3-none-any.whl",
            "kaji-0.2.0b1.tar.gz",
            "kaji-sdk-0.2.0-beta.1.tgz"
          ]
        },
        "package": { "enum": ["python", "typescript"] },
        "version": { "enum": ["0.2.0b1", "0.2.0-beta.1"] },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "automatedTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coldSetupToOutputMs", "warmRunMs", "toolchain"],
      "properties": {
        "coldSetupToOutputMs": { "$ref": "#/$defs/milliseconds" },
        "warmRunMs": { "$ref": "#/$defs/milliseconds" },
        "toolchain": { "$ref": "#/$defs/toolchain" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "uv", "node", "npm", "bun", "typescript"],
      "properties": {
        "python": { "$ref": "#/$defs/versionText" },
        "uv": { "$ref": "#/$defs/versionText" },
        "node": { "$ref": "#/$defs/versionText" },
        "npm": { "$ref": "#/$defs/versionText" },
        "bun": { "$ref": "#/$defs/versionText" },
        "typescript": { "$ref": "#/$defs/versionText" }
      }
    },
    "versionText": { "type": "string", "minLength": 1, "maxLength": 80 },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "durationMs"],
      "properties": {
        "name": {
          "enum": [
            "artifact-install",
            "scaffold-init",
            "no-key-run",
            "echo-setup",
            "echo-run"
          ]
        },
        "durationMs": { "$ref": "#/$defs/milliseconds" }
      }
    },
    "humanRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participantId",
        "os",
        "path",
        "cleanEnvironment",
        "noSourceCheckout",
        "toolchain",
        "steps",
        "noKeyTotalMs",
        "echoTotalMs",
        "assertions",
        "confusion",
        "redacted",
        "owner",
        "reviewDate",
        "followUpDate"
      ],
      "properties": {
        "participantId": {
          "type": "string",
          "pattern": "^user-[a-z0-9][a-z0-9-]{2,30}$"
        },
        "os": { "enum": ["macos", "linux"] },
        "path": { "enum": ["python", "npm", "bun"] },
        "cleanEnvironment": { "const": true },
        "noSourceCheckout": { "const": true },
        "toolchain": { "$ref": "#/$defs/toolchain" },
        "steps": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            { "$ref": "#/$defs/step" },
            { "$ref": "#/$defs/step" },
            { "$ref": "#/$defs/step" },
            { "$ref": "#/$defs/step" },
            { "$ref": "#/$defs/step" }
          ]
        },
        "noKeyTotalMs": { "$ref": "#/$defs/milliseconds" },
        "echoTotalMs": { "$ref": "#/$defs/milliseconds" },
        "assertions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deterministicText",
            "nonEmptyTurnId",
            "positiveSequence",
            "echoToolRequested",
            "echoToolStarted",
            "echoToolCompleted",
            "echoResultObserved"
          ],
          "properties": {
            "deterministicText": { "const": true },
            "nonEmptyTurnId": { "const": true },
            "positiveSequence": { "const": true },
            "echoToolRequested": { "const": true },
            "echoToolStarted": { "const": true },
            "echoToolCompleted": { "const": true },
            "echoResultObserved": { "const": true }
          }
        },
        "confusion": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary", "remediation"],
            "properties": {
              "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
              "remediation": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        },
        "redacted": { "const": true },
        "owner": { "type": "string", "minLength": 1, "maxLength": 80 },
        "reviewDate": { "type": "string", "format": "date" },
        "followUpDate": { "type": "string", "format": "date" }
      }
    }
  }
}
