{
  "name": "fs",
  "version": "0.1.0",
  "namespace": "fs",
  "description": "Experimental root-contained filesystem tools with explicit depth, entry, read, and write limits.",
  "auth": { "kind": "none" },
  "files": ["index.ts"],
  "tools": [
    {
      "name": "list",
      "description": "List files in a directory.",
      "parameters": {
        "type": "object",
        "properties": { "path": { "type": "string", "default": "." } },
        "additionalProperties": false
      },
      "risk": "read",
      "parallel_safe": false
    },
    {
      "name": "read",
      "description": "Read a file's contents.",
      "parameters": {
        "type": "object",
        "properties": { "path": { "type": "string" } },
        "required": ["path"],
        "additionalProperties": false
      },
      "risk": "read",
      "parallel_safe": false
    },
    {
      "name": "write",
      "description": "Write content to a file.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "content": { "type": "string" }
        },
        "required": ["path", "content"],
        "additionalProperties": false
      },
      "risk": "write",
      "parallel_safe": false
    },
    {
      "name": "glob",
      "description": "Glob for files matching a pattern.",
      "parameters": {
        "type": "object",
        "properties": { "pattern": { "type": "string" } },
        "required": ["pattern"],
        "additionalProperties": false
      },
      "risk": "read",
      "parallel_safe": false
    }
  ],
  "peerDeps": {}
}
