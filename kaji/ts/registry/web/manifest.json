{
  "name": "web",
  "version": "0.1.0",
  "namespace": "web",
  "description": "Experimental bounded web fetch/search requiring an explicit SSRF policy and address-pinning transport.",
  "auth": { "kind": "env", "env": "BRAVE_API_KEY", "optional": true },
  "files": ["index.ts"],
  "tools": [
    {
      "name": "fetch",
      "description": "Fetch a URL and extract readable text (reader mode).",
      "parameters": {
        "type": "object",
        "properties": { "url": { "type": "string", "format": "uri" } },
        "required": ["url"],
        "additionalProperties": false
      },
      "risk": "read",
      "parallel_safe": false
    },
    {
      "name": "fetch_raw",
      "description": "Fetch a URL and return raw HTML/text.",
      "parameters": {
        "type": "object",
        "properties": { "url": { "type": "string", "format": "uri" } },
        "required": ["url"],
        "additionalProperties": false
      },
      "risk": "read",
      "parallel_safe": false
    },
    {
      "name": "search",
      "description": "Web search via Brave Search API.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "count": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 }
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "risk": "read",
      "parallel_safe": false
    }
  ],
  "peerDeps": {}
}
