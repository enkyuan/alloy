{
  "include": ["src", "tests", "examples"],
  "exclude": ["examples/agentos"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "allowImportingTsExtensions": true,
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022"],
    "types": ["node", "bun"],
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "kaji-sdk/anthropic": ["./src/providers/anthropic.ts"],
      "kaji-sdk/integrations": ["./src/integrations/public.ts"],
      "kaji-sdk/integrations/github": ["./src/integrations/github.ts"],
      "kaji-sdk/openai": ["./src/providers/openai.ts"],
      "kaji-sdk/testing": ["./src/testing.ts"],
      "kaji-sdk": ["./src/index.ts"],
      "@/*": ["./src/*"]
    },
    "declaration": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  }
}
