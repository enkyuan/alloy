{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "cases": [
    {
      "name": "manifest with no authentication",
      "target": "manifest",
      "document": {
        "name": "echo",
        "version": "0.1.0",
        "namespace": "echo",
        "description": "Echo text.",
        "auth": { "kind": "none" },
        "files": ["index.ts"],
        "tools": [
          {
            "name": "say",
            "description": "Echo text.",
            "parameters": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "message": {
                  "$id": "https://kaji.dev/schemas/echo-message-v1.json",
                  "type": "string",
                  "pattern": "^[a-z]+$"
                }
              },
              "required": ["message"],
              "additionalProperties": false
            },
            "risk": "read",
            "parallel_safe": false
          }
        ]
      }
    },
    {
      "name": "manifest with optional environment authentication",
      "target": "manifest",
      "document": {
        "name": "search",
        "version": "0.1.0",
        "namespace": "search",
        "description": "Search text.",
        "auth": {
          "kind": "env",
          "env": "SEARCH_API_KEY",
          "optional": true,
          "docs": "https://example.com/auth"
        },
        "files": ["index.ts"],
        "tools": [
          {
            "name": "search",
            "description": "Search text.",
            "parameters": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string",
                  "pattern": "^(red|blue)-[0-9]{1,3}$"
                }
              }
            },
            "risk": "read",
            "parallel_safe": true,
            "timeout_ms": 1000
          }
        ]
      }
    },
    {
      "name": "manifest with OAuth authentication",
      "target": "manifest",
      "document": {
        "name": "mail",
        "version": "0.1.0",
        "namespace": "mail",
        "description": "Read mail.",
        "auth": {
          "kind": "oauth",
          "provider": "google",
          "clientIdEnv": "GOOGLE_CLIENT_ID",
          "clientSecretEnv": "GOOGLE_CLIENT_SECRET",
          "scopes": ["https://www.googleapis.com/auth/gmail.readonly"],
          "docs": "https://example.com/oauth"
        },
        "files": ["mail/index.ts"],
        "tools": [
          {
            "name": "read",
            "description": "Read mail.",
            "parameters": { "type": "object" },
            "risk": "read",
            "parallel_safe": false
          }
        ]
      }
    },
    {
      "name": "registry index with beta and experimental entries",
      "target": "index",
      "document": {
        "$schema": "./index.schema.json",
        "version": "0.1.0",
        "integrations": {
          "echo": {
            "manifest": "echo/manifest.json",
            "stability": "beta",
            "runtimes": ["python", "typescript"]
          },
          "http": {
            "manifest": "http/manifest.json",
            "stability": "experimental",
            "runtimes": ["typescript"]
          }
        }
      }
    }
  ]
}
