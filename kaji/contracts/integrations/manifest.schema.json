{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaji.dev/schemas/integration-manifest-v1.json",
  "title": "Kaji integration manifest",
  "type": "object",
  "required": ["name", "version", "namespace", "description", "auth", "files", "tools"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "none" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "env"],
          "properties": {
            "kind": { "const": "env" },
            "env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "optional": { "type": "boolean", "default": false },
            "docs": { "type": "string", "format": "uri" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "scopes"],
          "properties": {
            "kind": { "const": "oauth" },
            "scopes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "docs": { "type": "string", "format": "uri" }
          },
          "additionalProperties": false
        }
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_@.+-]+(?:/[A-Za-z0-9_@.+-]+)*$"
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "description", "risk"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": { "type": "string", "minLength": 1 },
          "risk": {
            "enum": ["read", "write", "external_effect", "financial", "destructive", "admin"]
          }
        }
      }
    },
    "extras": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "peerDeps": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
