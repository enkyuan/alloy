{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaji.dev/contracts/tasks/v1/schema.json",
  "title": "TaskSnapshot",
  "$defs": {
    "taskState": {
      "title": "TaskState",
      "type": "string",
      "enum": [
        "created",
        "running",
        "waiting_for_approval",
        "suspended",
        "reconciliation_required",
        "completed",
        "failed",
        "cancelled"
      ]
    }
  },
  "type": "object",
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "state": { "$ref": "#/$defs/taskState" },
    "sequence_cursor": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "https://kaji.dev/contracts/artifacts/v1/schema.json" }
    },
    "terminal_error_code": { "type": ["string", "null"] },
    "pending_approvals": { "type": "array", "items": { "type": "object" } }
  },
  "required": ["task_id", "state", "sequence_cursor", "created_at", "updated_at", "artifacts", "pending_approvals"],
  "additionalProperties": false
}
