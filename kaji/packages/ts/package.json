{
  "name": "@irogane/kaji",
  "version": "0.3.0-alpha.1",
  "description": "Embeddable SDK for building agents in TypeScript: event-sourced runtime, tool registry, session replay. Infra-free core.",
  "homepage": "https://github.com/enkyuan/alloy/blob/main/docs/kaji/README.md",
  "bugs": {
    "url": "https://github.com/enkyuan/alloy/issues"
  },
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enkyuan/alloy.git",
    "directory": "kaji/packages/ts"
  },
  "bin": {
    "kaji": "dist/cli/bin.js"
  },
  "files": [
    "LICENSE",
    "contracts",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/postgres.d.ts",
        "default": "./dist/postgres.js"
      },
      "require": {
        "types": "./dist/postgres.d.cts",
        "default": "./dist/postgres.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli/package-entry.d.ts",
        "default": "./dist/cli/package-entry.js"
      },
      "require": {
        "types": "./dist/cli/package-entry-cjs.d.cts",
        "default": "./dist/cli/package-entry-cjs.cjs"
      }
    }
  },
  "scripts": {
    "prebuild": "if [ -d ../../contracts ]; then uv run python ../../tooling/contracts/check.py --sync-typescript-package-contracts; fi",
    "build": "bun run clean && tsup",
    "dev": "tsup --watch",
    "typecheck": "if [ -d ../../contracts ]; then uv run python ../../tooling/contracts/check.py --sync-typescript-package-contracts; fi; tsc --noEmit",
    "typecheck:registry": "tsc -p tsconfig.registry.json --noEmit",
    "lint": "oxlint src tests scripts registry",
    "format": "oxfmt --write \"**/*.ts\"",
    "format:check": "oxfmt --check \"**/*.ts\"",
    "lint:package": "bun run build && publint run . --strict && attw --pack --profile node16",
    "parity": "uv run --project ../py python ../../scripts/check_sdk_parity.py",
    "test": "PATH=\"${PATH#*:}:/usr/local/bin:/opt/homebrew/bin\" /bin/sh -c 'exec \"$(command -v node)\" ./node_modules/vitest/vitest.mjs run \"$@\"' --",
    "test:quickstart": "PATH=\"${PATH#*:}:/usr/local/bin:/opt/homebrew/bin\" /bin/sh -c 'exec \"$(command -v node)\" ./node_modules/vitest/vitest.mjs run tests/contracts/docs.test.ts \"$@\"' --",
    "test:coverage": "PATH=\"${PATH#*:}:/usr/local/bin:/opt/homebrew/bin\" /bin/sh -c 'exec \"$(command -v node)\" ./node_modules/vitest/vitest.mjs run --coverage --coverage.include=\"src/**/*.ts\" --coverage.include=\"registry/**/*.ts\" --coverage.exclude=\"src/**/*.d.ts\" --coverage.exclude=\"registry/**/tests/**/*.test.ts\" --coverage.exclude=\"src/cli/bin.ts\" --coverage.exclude=\"src/cli/package-entry.ts\" --coverage.exclude=\"src/cli/package-entry-cjs.ts\" --coverage.exclude=\"src/cli/init-worker.ts\" --coverage.exclude=\"src/cli/bun-io.ts\" --coverage.exclude=\"src/backends/postgres/**\" --coverage.reporter=text --coverage.reporter=json-summary --coverage.thresholds.lines=80 --coverage.thresholds.functions=80 --coverage.thresholds.branches=80 --coverage.thresholds.statements=80 \"$@\"' --",
    "test:complexity": "PATH=\"${PATH#*:}:/usr/local/bin:/opt/homebrew/bin\" /bin/sh -c 'exec \"$(command -v node)\" ./node_modules/vitest/vitest.mjs run tests/runtime-complexity.test.ts tests/runtime-faults.test.ts \"$@\"' --",
    "test:watch": "PATH=\"${PATH#*:}:/usr/local/bin:/opt/homebrew/bin\" /bin/sh -c 'exec \"$(command -v node)\" ./node_modules/vitest/vitest.mjs \"$@\"' --",
    "clean": "rm -rf dist",
    "package:smoke": "bun run build && bun scripts/smoke_package.mts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.4",
    "@dotenvx/dotenvx": "2.9.0",
    "@types/bun": "^1.0.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "4.1.9",
    "oxfmt": "^0.54.0",
    "publint": "0.3.21",
    "tsup": "^8.3.5",
    "typescript": "^6.0.2",
    "typescript57": "npm:typescript@5.7.3",
    "vitest": "4.1.9",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "zod": ">=4.3 <5"
  },
  "optionalDependencies": {
    "postgres": "^3.4.7"
  },
  "engines": {
    "node": "22.x || 24.x"
  }
}
