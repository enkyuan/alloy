{
  "name": "github",
  "version": "0.1.0",
  "namespace": "github",
  "description": "Repository-scoped GitHub code, issue, and comment tools.",
  "auth": {
    "kind": "env",
    "env": "GITHUB_TOKEN",
    "docs": "https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens"
  },
  "files": [
    "index.ts",
    "client.ts",
    "tests/github.test.ts",
    "owner-fixtures.json",
    "LICENSE"
  ],
  "tools": [
    {
      "name": "add_comment",
      "description": "Add a comment to a GitHub issue.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
          },
          "issue_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        },
        "required": [
          "repository",
          "issue_number",
          "body"
        ],
        "additionalProperties": false
      },
      "risk": "external_effect",
      "parallel_safe": false,
      "timeout_ms": 15000
    },
    {
      "name": "create_issue",
      "description": "Create a GitHub issue.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "body": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384
          }
        },
        "required": [
          "repository",
          "title",
          "body"
        ],
        "additionalProperties": false
      },
      "risk": "external_effect",
      "parallel_safe": false,
      "timeout_ms": 15000
    },
    {
      "name": "get_file",
      "description": "Get a file from a GitHub repository.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "repository",
          "path"
        ],
        "additionalProperties": false
      },
      "risk": "read",
      "parallel_safe": true,
      "timeout_ms": 10000
    },
    {
      "name": "get_issue",
      "description": "Get a GitHub issue.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
          },
          "issue_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "repository",
          "issue_number"
        ],
        "additionalProperties": false
      },
      "risk": "read",
      "parallel_safe": true,
      "timeout_ms": 10000
    },
    {
      "name": "list_issues",
      "description": "List GitHub issues.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "all"
            ],
            "default": "open"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10
          }
        },
        "required": [
          "repository"
        ],
        "additionalProperties": false
      },
      "risk": "read",
      "parallel_safe": true,
      "timeout_ms": 10000
    },
    {
      "name": "search_code",
      "description": "Search code in a GitHub repository.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10
          }
        },
        "required": [
          "repository",
          "query"
        ],
        "additionalProperties": false
      },
      "risk": "read",
      "parallel_safe": true,
      "timeout_ms": 10000
    }
  ],
  "peerDeps": {}
}
