{
  "include": ["src", "tests", "examples"],
  "exclude": ["examples", "registry"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "allowImportingTsExtensions": true,
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022"],
    "types": ["node", "bun"],
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@irogane/kaji/postgres": ["./src/backends/postgres/index.ts"],
      "@irogane/kaji": ["./src/index.ts"],
      "@/*": ["./src/*"]
    },
    "declaration": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  }
}
