{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaji.dev/contracts/integrations/gmail-api-conformance-v1.json",
  "version": "1.0.0",
  "token": "fixture-token",
  "cases": [
    {
      "name": "list messages",
      "operation": "list_messages",
      "input": {
        "query": "from:alice",
        "maxResults": 5
      },
      "responses": [
        {
          "status": 200,
          "headers": {
            "content-type": "application/json"
          },
          "json": {
            "messages": [
              {
                "id": "abc123",
                "threadId": "thread1"
              },
              {
                "id": "def456",
                "threadId": "thread2"
              }
            ],
            "resultSizeEstimate": 2,
            "nextPageToken": "CURSOR_2"
          }
        }
      ],
      "expected_requests": [
        {
          "method": "GET",
          "path_and_query": "/gmail/v1/users/me/messages?maxResults=5&q=from%3Aalice",
          "body": null
        }
      ],
      "expected": {
        "result": {
          "messages": [
            {
              "id": "abc123",
              "thread_id": "thread1"
            },
            {
              "id": "def456",
              "thread_id": "thread2"
            }
          ],
          "result_size_estimate": 2,
          "next_page_token": "CURSOR_2"
        }
      }
    },
    {
      "name": "list messages empty",
      "operation": "list_messages",
      "input": {},
      "responses": [
        {
          "status": 200,
          "headers": {},
          "json": {
            "resultSizeEstimate": 0
          }
        }
      ],
      "expected_requests": [
        {
          "method": "GET",
          "path_and_query": "/gmail/v1/users/me/messages?maxResults=10",
          "body": null
        }
      ],
      "expected": {
        "result": {
          "messages": [],
          "result_size_estimate": 0
        }
      }
    },
    {
      "name": "list messages with pagination",
      "operation": "list_messages",
      "input": {
        "maxResults": 1,
        "pageToken": "PREV_CURSOR"
      },
      "responses": [
        {
          "status": 200,
          "headers": {},
          "json": {
            "messages": [
              {
                "id": "m1",
                "threadId": "t1"
              }
            ],
            "nextPageToken": "NEXT_PAGE_42",
            "resultSizeEstimate": 50
          }
        }
      ],
      "expected_requests": [
        {
          "method": "GET",
          "path_and_query": "/gmail/v1/users/me/messages?maxResults=1&pageToken=PREV_CURSOR",
          "body": null
        }
      ],
      "expected": {
        "result": {
          "messages": [
            {
              "id": "m1",
              "thread_id": "t1"
            }
          ],
          "next_page_token": "NEXT_PAGE_42",
          "result_size_estimate": 50
        }
      }
    },
    {
      "name": "get message text plain",
      "operation": "get_message",
      "input": {
        "messageId": "abc123"
      },
      "responses": [
        {
          "status": 200,
          "headers": {},
          "json": {
            "id": "abc123",
            "threadId": "thread1",
            "snippet": "hello there",
            "payload": {
              "headers": [
                {
                  "name": "From",
                  "value": "alice@example.com"
                },
                {
                  "name": "Subject",
                  "value": "Hi"
                },
                {
                  "name": "X-Noise",
                  "value": "dropped"
                }
              ],
              "mimeType": "multipart/alternative",
              "parts": [
                {
                  "mimeType": "text/html",
                  "body": {
                    "data": "PHA-aWdub3JlZDwvcD4"
                  }
                },
                {
                  "mimeType": "text/plain",
                  "body": {
                    "data": "cGxhaW4gYm9keQ"
                  }
                }
              ]
            }
          }
        }
      ],
      "expected_requests": [
        {
          "method": "GET",
          "path_and_query": "/gmail/v1/users/me/messages/abc123?format=full",
          "body": null
        }
      ],
      "expected": {
        "result": {
          "body": "plain body",
          "body_truncated": false,
          "headers": {
            "from": "alice@example.com",
            "subject": "Hi"
          },
          "id": "abc123",
          "snippet": "hello there",
          "thread_id": "thread1"
        }
      }
    },
