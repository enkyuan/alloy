      ],
      "expected": {
        "result": {
          "body": "",
          "body_truncated": false,
          "headers": {},
          "id": "noBody01",
          "snippet": "",
          "thread_id": "noBody01"
        }
      }
    },
    {
      "name": "send message",
      "operation": "send_message",
      "input": {
        "raw": "RnJvbTogbWVAZXhhbXBsZS5jb20NClRvOiB5b3VAZXhhbXBsZS5jb20NCg0KSGk"
      },
      "responses": [
        {
          "status": 200,
          "headers": {},
          "json": {
            "id": "sent1",
            "threadId": "thread9"
          }
        }
      ],
      "expected_requests": [
        {
          "method": "POST",
          "path_and_query": "/gmail/v1/users/me/messages/send",
          "body": "{\"raw\":\"RnJvbTogbWVAZXhhbXBsZS5jb20NClRvOiB5b3VAZXhhbXBsZS5jb20NCg0KSGk\"}"
        }
      ],
      "expected": {
        "result": {
          "id": "sent1",
          "thread_id": "thread9"
        }
      }
    },
    {
      "name": "401 requires authentication",
      "operation": "list_messages",
      "input": {},
      "responses": [
        {
          "status": 401,
          "headers": {},
          "json": {}
