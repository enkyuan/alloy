      ],
      "expected": {
        "error": {
          "code": "INTEGRATION_AUTH_REQUIRED",
          "outcome": "failed",
          "retryable": false
        }
      }
    },
    {
      "name": "permission 403 is not rate limit",
      "operation": "list_messages",
      "input": {},
