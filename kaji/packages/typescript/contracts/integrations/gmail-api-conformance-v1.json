      "expected": {
        "error": {
          "code": "INTEGRATION_API_ERROR",
          "outcome": "failed",
          "retryable": false
        }
      }
    },
    {
      "name": "rate limited read retries once",
      "operation": "list_messages",
      "input": {},
      "responses": [
        {
          "status": 429,
          "headers": {
            "retry-after": "1"
          },
          "json": {}
        },
        {
          "status": 200,
          "headers": {},
          "json": {
            "messages": [
              {
                "id": "abc123",
                "threadId": "thread1"
              }
            ]
          }
        }
      ],
      "expected_requests": [
        {
          "method": "GET",
          "path_and_query": "/gmail/v1/users/me/messages?maxResults=10",
          "body": null
        },
        {
          "method": "GET",
          "path_and_query": "/gmail/v1/users/me/messages?maxResults=10",
          "body": null
        }
      ],
      "expected": {
        "result": {
          "messages": [
            {
              "id": "abc123",
              "thread_id": "thread1"
            }
          ]
        }
      },
      "expected_sleeps": [
        1000
      ]
    },
    {
      "name": "404 is confirmed read failure",
      "operation": "get_message",
      "input": {
        "messageId": "missing01"
      },
      "responses": [
        {
          "status": 404,
          "headers": {},
          "json": {}
        }
      ],
      "expected_requests": [
        {
          "method": "GET",
          "path_and_query": "/gmail/v1/users/me/messages/missing01?format=full",
          "body": null
        }
      ],
      "expected": {
        "error": {
          "code": "INTEGRATION_API_ERROR",
          "outcome": "failed",
          "retryable": false
        }
      }
    },
    {
      "name": "429 mutation is not retried",
      "operation": "send_message",
      "input": {
        "raw": "RnJvbTogbWVAZXhhbXBsZS5jb20NCg0KSGk"
      },
      "responses": [
        {
          "status": 429,
          "headers": {
            "retry-after": "1"
          },
          "json": {}
        }
      ],
      "expected_requests": [
        {
          "method": "POST",
          "path_and_query": "/gmail/v1/users/me/messages/send",
          "body": "{\"raw\":\"RnJvbTogbWVAZXhhbXBsZS5jb20NCg0KSGk\"}"
        }
      ],
      "expected": {
        "error": {
          "code": "INTEGRATION_RATE_LIMITED",
          "outcome": "failed",
          "retryable": true
        }
      }
    },
