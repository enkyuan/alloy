            "tool_name": {
              "$ref": "#/$defs/nonEmptyId"
            },
            "tool_call_id": {
              "$ref": "#/$defs/nonEmptyId"
            },
            "error": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "error_code": {
              "type": "string"
            },
            "error_path": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "outcome": {
              "enum": [
                "not_started",
                "failed",
                "unknown"
