{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "cases": [
    {
      "name": "nested object, format, and bounded array",
      "schema": {
        "type": "object",
        "required": ["profile", "tags"],
        "additionalProperties": false,
        "properties": {
          "profile": {
            "type": "object",
            "required": ["email", "role"],
            "additionalProperties": false,
            "properties": {
              "email": { "type": "string", "format": "email" },
              "role": { "enum": ["admin", "member"] }
            }
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": { "type": "string", "minLength": 2, "maxLength": 8 }
          }
        }
      },
      "arguments": {
        "profile": { "email": "user@example.com", "role": "member" },
        "tags": ["beta"]
      }
    },
    {
      "name": "const and number bounds",
      "schema": {
        "type": "object",
        "required": ["mode", "count"],
        "properties": {
          "mode": { "const": "strict" },
          "count": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      },
      "arguments": { "mode": "strict", "count": 3 }
    },
    {
      "name": "union branch",
      "schema": {
        "type": "object",
        "required": ["target"],
        "properties": {
          "target": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "integer", "minimum": 1 }
            ]
          }
        }
      },
      "arguments": { "target": 2 }
    },
    {
      "name": "local reference",
      "schema": {
        "$defs": {
          "target": {
            "type": "object",
            "required": ["url"],
            "properties": { "url": { "type": "string", "format": "uri" } }
          }
        },
        "type": "object",
        "required": ["target"],
        "properties": { "target": { "$ref": "#/$defs/target" } }
      },
      "arguments": { "target": { "url": "https://example.com/resource" } }
    }
  ]
}
