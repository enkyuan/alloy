{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "namespace": "echo",
  "tools": [
    {
      "name": "say",
      "description": "Return the input string unchanged.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        },
        "required": ["message"],
        "additionalProperties": false
      },
      "risk": "read",
      "parallel_safe": false
    },
    {
      "name": "shout",
      "description": "Return the input string uppercased.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        },
        "required": ["message"],
        "additionalProperties": false
      },
      "risk": "read",
      "parallel_safe": false
    }
  ]
}
