  "$defs": {
    "hex40": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "hex64": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "not": { "pattern": "[^!-~]" }
    },
    "npmSha512": {
      "type": "string",
      "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$",
      "not": { "pattern": "[^!-~]" }
    },
    "basename": {
      "type": "string",
      "pattern": "^kaji-sdk-(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?\\.tgz$",
      "not": { "pattern": "[^!-~]" }
    },
    "positiveInt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[!-~]+$",
      "not": { "pattern": "[^!-~]" }
    },
    "email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 254,
      "pattern": "^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]{1,64}@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$",
      "not": { "pattern": "[^!-~]" }
    },
    "tagName": {
      "type": "string",
      "minLength": 6,
      "maxLength": 128,
      "pattern": "^kaji-[A-Za-z0-9](?:[A-Za-z0-9_-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9_-]*[A-Za-z0-9])?)*$",
      "allOf": [
        { "not": { "pattern": "\\.lock$" } },
        { "not": { "pattern": "[^!-~]" } }
      ]
    },
    "httpsUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https://github\\.com/enkyuan/alloy/attestations/[A-Za-z0-9._~-]{1,128}$",
      "not": { "pattern": "[^!-~]" }
    },
    "signerWorkflowRef": {
      "type": "string",
      "pattern": "^enkyuan/alloy/\\.github/workflows/kaji\\.handoff\\.trusted\\.yml@[0-9a-f]{40}$",
      "not": { "pattern": "[^!-~]" }
    },
    "rangeSpec": {
      "type": "string",
      "minLength": 82,
      "maxLength": 82,
      "pattern": "^[0-9a-f]{40}\\.\\.[0-9a-f]{40}$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\/$)[!-~]+$",
      "allOf": [
        { "not": { "pattern": "[^!-~]" } },
        { "not": { "pattern": "\\\\" } }
      ]
    },
    "signerWorkflowIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "filePath", "digest", "ref"],
      "properties": {
        "repository": { "const": "enkyuan/alloy" },
        "filePath": { "const": ".github/workflows/kaji.handoff.trusted.yml" },
        "digest": { "$ref": "#/$defs/hex40" },
