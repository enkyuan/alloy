{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaji.dev/contracts/release/typescript-onboarding-evidence-v1.schema.json",
  "title": "Kaji TypeScript onboarding evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commit",
    "releaseManifestSha256",
    "packageArtifact",
    "producerArtifact",
    "cells"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "commit": {
      "$ref": "#/$defs/commit"
    },
    "releaseManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "packageArtifact": {
      "$ref": "#/$defs/packageArtifact"
    },
    "producerArtifact": {
      "$ref": "#/$defs/producerArtifact"
    },
    "cells": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/node22Cell"
        },
        {
          "$ref": "#/$defs/node24Cell"
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonnegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "imageVersion": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,127}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "typescriptVersion": {
      "type": "string",
      "pattern": "^5\\.7\\.3 and (?!5\\.7\\.3$)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "node22Version": {
      "type": "string",
      "pattern": "^v22\\.[0-9]+\\.[0-9]+$"
    },
    "node24Version": {
      "type": "string",
      "pattern": "^v24\\.[0-9]+\\.[0-9]+$"
    },
    "packageArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "size",
        "sha256"
      ],
      "properties": {
        "name": {
          "const": "kaji-sdk-0.2.0-beta.9.tgz"
        },
        "size": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "producerArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id",
        "digest",
        "runId",
        "runAttempt",
        "headSha"
      ],
      "properties": {
        "name": {
          "const": "kaji-beta-artifacts"
        },
        "id": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "digest": {
          "$ref": "#/$defs/artifactDigest"
        },
        "runId": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "runAttempt": {
          "const": 1
        },
        "headSha": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "sourceArtifact22": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id",
        "digest",
        "runId",
        "runAttempt",
        "headSha",
        "receiptSha256"
      ],
      "properties": {
        "name": {
          "const": "kaji-node-compat-22"
        },
        "id": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "digest": {
          "$ref": "#/$defs/artifactDigest"
        },
        "runId": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "runAttempt": {
          "const": 1
        },
        "headSha": {
          "$ref": "#/$defs/commit"
        },
        "receiptSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceArtifact24": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id",
        "digest",
        "runId",
        "runAttempt",
        "headSha",
        "receiptSha256"
      ],
      "properties": {
        "name": {
          "const": "kaji-node-compat-24"
        },
        "id": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "digest": {
          "$ref": "#/$defs/artifactDigest"
        },
        "runId": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "runAttempt": {
          "const": 1
        },
        "headSha": {
          "$ref": "#/$defs/commit"
        },
        "receiptSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtime22": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/node22Version"
        }
      }
    },
    "runtime24": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/node24Version"
        }
      }
    },
    "runner22": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuredLabel",
        "environment",
        "runnerOS",
        "runnerArch",
        "platformOS",
        "platformArch",
        "imageOS",
        "imageVersion"
      ],
      "properties": {
        "configuredLabel": {
          "const": "ubuntu-22.04"
        },
        "environment": {
          "const": "github-hosted"
        },
        "runnerOS": {
          "const": "Linux"
        },
        "runnerArch": {
          "const": "X64"
        },
        "platformOS": {
          "const": "linux"
        },
        "platformArch": {
          "const": "x64"
        },
        "imageOS": {
          "const": "ubuntu22"
        },
        "imageVersion": {
          "$ref": "#/$defs/imageVersion"
        }
      }
    },
    "runner24": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuredLabel",
        "environment",
        "runnerOS",
        "runnerArch",
        "platformOS",
        "platformArch",
        "imageOS",
        "imageVersion"
      ],
      "properties": {
        "configuredLabel": {
          "const": "ubuntu-24.04"
        },
        "environment": {
          "const": "github-hosted"
        },
        "runnerOS": {
          "const": "Linux"
        },
        "runnerArch": {
          "const": "X64"
        },
        "platformOS": {
          "const": "linux"
        },
        "platformArch": {
          "const": "x64"
        },
        "imageOS": {
          "const": "ubuntu24"
        },
        "imageVersion": {
          "$ref": "#/$defs/imageVersion"
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowRun",
        "runId",
        "runAttempt",
        "workflowRef",
        "workflowSha",
        "job"
      ],
      "properties": {
        "workflowRun": {
          "type": "string",
          "pattern": "^https://github\\.com/enkyuan/alloy/actions/runs/[1-9][0-9]*$"
        },
        "runId": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "runAttempt": {
          "const": 1
        },
        "workflowRef": {
          "enum": [
            "enkyuan/alloy/.github/workflows/kaji.rehearsal.yml@refs/heads/main",
            "enkyuan/alloy/.github/workflows/kaji.publish.yml@refs/tags/kaji-v0.2.0-beta.9"
          ]
        },
        "workflowSha": {
          "$ref": "#/$defs/commit"
        },
        "job": {
          "const": "node-compat"
        }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactInstall",
        "scaffoldInit",
        "noKeyRun",
        "echoSetup",
        "echoRun",
        "coldRun",
        "warmRun"
      ],
      "properties": {
        "artifactInstall": {
          "const": true
        },
        "scaffoldInit": {
          "const": true
        },
        "noKeyRun": {
          "const": true
        },
        "echoSetup": {
          "const": true
        },
        "echoRun": {
          "const": true
        },
        "coldRun": {
          "const": true
        },
        "warmRun": {
          "const": true
        }
      }
    },
    "echoLifecycleCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "started",
        "completed"
      ],
      "properties": {
        "requested": {
          "const": 1
        },
        "started": {
          "const": 1
        },
        "completed": {
          "const": 1
        }
      }
    },
    "echoResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "const": "hello"
        }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noKeyText",
        "deterministicText",
        "turnIdPresent",
        "finalSequencePositive",
        "echoLifecycle",
        "echoLifecycleCounts",
        "echoToolCallIdentityCount",
        "echoToolCallIdNonempty",
        "echoResult",
        "echoFinalText",
        "forbiddenTerminalEventsAbsent",
        "coldWarmEqual"
      ],
      "properties": {
        "noKeyText": {
          "const": "The mock provider has completed the tool loop."
        },
        "deterministicText": {
          "const": "The mock provider has completed the tool loop."
        },
        "turnIdPresent": {
          "const": true
        },
        "finalSequencePositive": {
          "const": true
        },
        "echoLifecycle": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "const": "requested"
            },
            {
              "const": "started"
            },
            {
              "const": "completed"
            }
          ],
          "items": false
        },
        "echoLifecycleCounts": {
          "$ref": "#/$defs/echoLifecycleCounts"
        },
        "echoToolCallIdentityCount": {
          "const": 1
        },
        "echoToolCallIdNonempty": {
          "const": true
        },
        "echoResult": {
          "$ref": "#/$defs/echoResult"
        },
        "echoFinalText": {
          "const": "The mock provider has completed the tool loop."
        },
        "forbiddenTerminalEventsAbsent": {
          "const": true
        },
        "coldWarmEqual": {
          "const": true
        }
      }
    },
    "npmOnboardingProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manager",
        "phases",
        "assertions"
      ],
      "properties": {
        "manager": {
          "const": "npm"
        },
        "phases": {
          "$ref": "#/$defs/phases"
        },
        "assertions": {
          "$ref": "#/$defs/assertions"
        }
      }
    },
    "bunOnboardingProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manager",
        "phases",
        "assertions"
      ],
      "properties": {
        "manager": {
          "const": "bun"
        },
        "phases": {
          "$ref": "#/$defs/phases"
        },
        "assertions": {
          "$ref": "#/$defs/assertions"
        }
      }
    },
    "onboardingProofs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "npm",
        "bun"
      ],
      "properties": {
        "npm": {
          "$ref": "#/$defs/npmOnboardingProof"
        },
        "bun": {
          "$ref": "#/$defs/bunOnboardingProof"
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coldSetupToOutputMs",
        "warmRunMs"
      ],
      "properties": {
        "coldSetupToOutputMs": {
          "$ref": "#/$defs/nonnegativeSafeInteger"
        },
        "warmRunMs": {
          "$ref": "#/$defs/nonnegativeSafeInteger"
        }
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "npm",
        "bun"
      ],
      "properties": {
        "npm": {
          "$ref": "#/$defs/timing"
        },
        "bun": {
          "$ref": "#/$defs/timing"
        }
      }
    },
    "toolchain22": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "uv",
        "node",
        "npm",
        "bun",
        "typescript"
      ],
      "properties": {
        "python": {
          "const": "not-used"
        },
        "uv": {
          "const": "not-used"
        },
        "node": {
          "$ref": "#/$defs/node22Version"
        },
        "npm": {
          "$ref": "#/$defs/semver"
        },
        "bun": {
          "const": "1.3.11"
        },
        "typescript": {
          "$ref": "#/$defs/typescriptVersion"
        }
      }
    },
    "toolchain24": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "uv",
        "node",
        "npm",
        "bun",
        "typescript"
      ],
      "properties": {
        "python": {
          "const": "not-used"
        },
        "uv": {
          "const": "not-used"
        },
        "node": {
          "$ref": "#/$defs/node24Version"
        },
        "npm": {
          "$ref": "#/$defs/semver"
        },
        "bun": {
          "const": "1.3.11"
        },
        "typescript": {
          "$ref": "#/$defs/typescriptVersion"
        }
      }
    },
    "node22Cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionMode",
        "sourceArtifact",
        "runtime",
        "runner",
        "invocation",
        "onboardingProofs",
        "timings",
        "toolchain",
        "conclusion",
        "failureCode"
      ],
      "properties": {
        "executionMode": {
          "const": "protected"
        },
        "sourceArtifact": {
          "$ref": "#/$defs/sourceArtifact22"
        },
        "runtime": {
          "$ref": "#/$defs/runtime22"
        },
        "runner": {
          "$ref": "#/$defs/runner22"
        },
        "invocation": {
          "$ref": "#/$defs/invocation"
        },
        "onboardingProofs": {
          "$ref": "#/$defs/onboardingProofs"
        },
        "timings": {
          "$ref": "#/$defs/timings"
        },
        "toolchain": {
          "$ref": "#/$defs/toolchain22"
        },
        "conclusion": {
          "const": "passed"
        },
        "failureCode": {
          "type": "null"
        }
      }
    },
    "node24Cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionMode",
        "sourceArtifact",
        "runtime",
        "runner",
        "invocation",
        "onboardingProofs",
        "timings",
        "toolchain",
        "conclusion",
        "failureCode"
      ],
      "properties": {
        "executionMode": {
          "const": "protected"
        },
        "sourceArtifact": {
          "$ref": "#/$defs/sourceArtifact24"
        },
        "runtime": {
          "$ref": "#/$defs/runtime24"
        },
        "runner": {
          "$ref": "#/$defs/runner24"
        },
        "invocation": {
          "$ref": "#/$defs/invocation"
        },
        "onboardingProofs": {
          "$ref": "#/$defs/onboardingProofs"
        },
        "timings": {
          "$ref": "#/$defs/timings"
        },
        "toolchain": {
          "$ref": "#/$defs/toolchain24"
        },
        "conclusion": {
          "const": "passed"
        },
        "failureCode": {
          "type": "null"
        }
      }
    }
  }
}
